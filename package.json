{
  "name": "workroom",
  "version": "0.1.0",
  "private": true,
  "description": "A spatial workspace for collaborating AI agents.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node scripts/launch.mjs",
    "local": "node scripts/launch.mjs --workspace",
    "demo:prepare": "node scripts/launch.mjs --prepare-only",
    "codespace:start": "node scripts/codespace.mjs",
    "codespace:restart": "node scripts/codespace.mjs --restart",
    "dev": "concurrently -k -n runtime,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "worker": "node examples/external-worker.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@openai/codex-sdk": "0.163.0",
    "@react-three/drei": "^10.0.7",
    "@react-three/fiber": "^9.1.2",
    "docx": "^9.12.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.176.0",
    "write-excel-file": "^4.1.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guiltyascharged123/Coding-Chet.git"
  }
}
