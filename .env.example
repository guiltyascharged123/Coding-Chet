# Local-first defaults. Never commit your .env file.
PORT=3001
HOST=127.0.0.1
# Leave unset to retain the saved connection; a new workspace defaults to Ollama.
# AGENT_PROVIDER=ollama
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required only for external workers. Generate: openssl rand -hex 32
# RUNNER_TOKEN=
# DATABASE_PATH=.data/workroom.sqlite
# Optional browser origin when using a trusted reverse proxy.
# WORKROOM_ORIGIN=https://your-forwarded-host.example
# Normal startup uses the real workspace, including the legacy demo command alias.

# ChatGPT subscription via the supported Codex CLI; no paid API fallback.
# From the project: npx --no-install codex login. Select an exact account model ID.
# WORKROOM_CODEX_ENABLED=1
# WORKROOM_CODEX_MODEL=your-exact-model-id
# Optional absolute native executable path; defaults to the pinned bundled CLI.
# WORKROOM_CODEX_BIN=

# npm run local installs/starts Ollama and pulls this exact tag on first use.
# Change the tag to use another local model. Existing installed weights are reused.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=huihui_ai/qwen3.5-abliterated:4B
# Set to 0 to manage Ollama yourself or use a separately configured provider.
WORKROOM_LOCAL_SETUP=1

# LM Studio, llama.cpp or another Chat Completions server. Remote requires HTTPS.
# COMPATIBLE_API_URL=http://127.0.0.1:1234/v1
# COMPATIBLE_MODEL=your-exact-model-id
# COMPATIBLE_API_KEY=
# Default is paid. Local exempts only a loopback server from API budget estimates.
# COMPATIBLE_BILLING=local
