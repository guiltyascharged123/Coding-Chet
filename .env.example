# Demo mode works without credentials. Never commit your .env file.
PORT=3001
HOST=127.0.0.1
# Optional startup override; leave unset to retain the selected runtime.
# AGENT_PROVIDER=demo
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required only for external workers. Generate: openssl rand -hex 32
# RUNNER_TOKEN=
# DATABASE_PATH=.data/workroom.sqlite
# DEMO_STEP_MS=8000
# Optional browser origin when using a trusted reverse proxy.
# WORKROOM_ORIGIN=https://your-forwarded-host.example
# npm run demo uses port 3000 and a separate demo database.
# WORKROOM_DEMO_PORT=3000
