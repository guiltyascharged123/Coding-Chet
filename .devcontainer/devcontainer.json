{
  "name": "Workroom workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "remoteUser": "node",
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": {
      "label": "Workroom",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm run local:prepare",
  "postStartCommand": "npm run codespace:start"
}
